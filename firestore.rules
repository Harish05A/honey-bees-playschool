rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default rule: Deny all unauthenticated reads and writes across the database
    match /{document=**} {
      allow read, write: if false;
    }

    // Tuition Center Students collection: Restricted to authenticated staff members
    match /tuitionStudents/{studentId} {
      allow read, write: if request.auth != null;
    }

    // Attendance collection: Restricted to authenticated staff members
    match /attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    // Fee Records collection: Restricted to authenticated staff members
    match /feeRecords/{feeId} {
      allow read, write: if request.auth != null;
    }

    // Settings collection: Restricted to authenticated staff members
    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }

    // Play School Students collection: Restricted to authenticated staff members
    match /schoolStudents/{studentId} {
      allow read, write: if request.auth != null;
    }

    // Teachers collection: Restricted to authenticated staff members
    match /teachers/{teacherId} {
      allow read, write: if request.auth != null;
    }

    // Play School Attendance collection: Restricted to authenticated staff members
    match /schoolAttendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    // Play School Fee Records collection: Restricted to authenticated staff members
    match /schoolFeeRecords/{feeId} {
      allow read, write: if request.auth != null;
    }

    // Teacher Salary Records collection: Restricted to authenticated staff members
    match /teacherSalaryRecords/{salaryId} {
      allow read, write: if request.auth != null;
    }
  }
}

